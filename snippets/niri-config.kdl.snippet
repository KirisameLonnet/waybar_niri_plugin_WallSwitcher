layer-rule {
    match namespace="^swww-daemon$"
    place-within-backdrop true
}
layer-rule {
    match namespace="^mpvpaper$"
    place-within-backdrop true
}

spawn-sh-at-startup "/home/lonnet/.config/waybar/modules/wallpaper-switcher.sh restore"

binds {
    Mod+Ctrl+R { spawn-sh "touch /home/lonnet/.config/niri/config.kdl"; }
    Mod+Ctrl+W { spawn-sh "/home/lonnet/.config/scripts/toggle-waybar.sh"; }
    Mod+Ctrl+B { spawn-sh "/home/lonnet/.config/waybar/modules/wallpaper-switcher.sh menu"; }
}
